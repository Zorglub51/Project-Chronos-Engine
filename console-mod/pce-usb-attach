#!/bin/sh
# udev RUN handler: USB partition appeared.

. /usr/bin/pce-usb-lib.sh

DEV=/dev/$1
pce_log "attach $DEV"

for i in 1 2 3 4 5; do
    [ -b "$DEV" ] && break
    sleep 0.2 2>/dev/null || sleep 1
done
[ -b "$DEV" ] || { pce_log "no $DEV"; exit 0; }

mounted_device=$(mount | awk -v t="$USB_MNT" '$3 == t {print $1; exit}')
if [ -n "$mounted_device" ] && [ "$mounted_device" != "$DEV" ]; then
    pce_log "ignoring $DEV: library already mounted from $mounted_device"
    exit 0
fi
if [ -z "$mounted_device" ]; then
    mkdir -p "$USB_MNT"
    if ! mount -t vfat -o rw,sync,uid=0,gid=0,fmask=0022,dmask=0022 "$DEV" "$USB_MNT" 2>>${LOG}; then
        pce_log "mount $DEV failed"
        rmdir "$USB_MNT" 2>/dev/null
        exit 0
    fi
fi

pce_check_library || { umount "$USB_MNT" 2>/dev/null; exit 0; }

# Only restart engine if it's already running (hot-plug case). At cold
# boot, mount-usb-drives + udev coldplug both fire pce-usb-attach while
# m2engage isn't up yet — S99first_startup will launch it once after rcS.
restart_engine=
if pidof m2engage >/dev/null 2>&1; then
    restart_engine=1
    pce_kill_engine
fi

# Replace mounts only after the old engine has stopped.
if ! pce_apply_bind; then
    pce_drop_binds
    umount "$USB_MNT" 2>/dev/null
    [ -n "$restart_engine" ] && pce_schedule_start
    exit 1
fi

if [ -n "$restart_engine" ]; then
    pce_schedule_start
    pce_log "hot-plug: engine restart scheduled"
else
    pce_log "boot path: engine not running, S99first_startup will launch it"
fi
exit 0
