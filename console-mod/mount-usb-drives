#!/bin/sh
#
# /bin/mount-usb-drives — boot-time splash + USB detection + game bind.
#
# Called by S11chronos-usb after rcS's read-only remount. Decodes the splash to
# /dev/fb0, then polls `/dev/sd*[1-9]` for 10 seconds. If a USB partition
# appears with a /game/ tree on it, mount + bind /game over /usr/game
# before S99first_startup starts the engine. Stock boot if no stick within 10 s.

. /usr/bin/pce-usb-lib.sh
LOG=/tmp/mount-usb-drives.log
SPLASH=/usr/local/wait.gz

log() { echo "[$(date +%H:%M:%S)] $*" >>${LOG}; }

# S10udev's cold-plug event may already have set up the same key.
# Do not stack a second USB mount or disturb a completed setup.
if mount | grep -q " $USB_MNT "; then
    log "USB already prepared by udev"
    exit 0
fi

# Splash now (user-visible during the probe window).
[ -f "$SPLASH" ] && gzip -dc "$SPLASH" > /dev/fb0 2>/dev/null

# 10 s poll: 100 × 100 ms. Exits the moment a partition node appears.
device=
i=0
while [ $i -lt 100 ]; do
    for d in /dev/sd*[1-9]; do
        [ -b "$d" ] || continue
        device="$d"
        break 2
    done
    sleep 0.1 2>/dev/null || sleep 1
    i=$((i + 1))
done

if [ -z "$device" ]; then
    log "no USB after 10s, stock boot"
    exit 0
fi
log "found $device after ${i}00ms"

mkdir -p "$USB_MNT"
if ! mount -t vfat -o rw,sync,uid=0,gid=0,fmask=0022,dmask=0022 "$device" "$USB_MNT" 2>>${LOG}; then
    log "mount $device failed"
    rmdir "$USB_MNT" 2>/dev/null
    exit 0
fi

if ! pce_check_library; then
    log "not a published library stick"
    umount "$USB_MNT" 2>/dev/null
    rmdir "$USB_MNT" 2>/dev/null
    exit 0
fi

if ! pce_apply_bind; then
    log "USB setup failed, continue stock boot"
    umount "$USB_MNT" 2>/dev/null
    exit 0
fi

exit 0
