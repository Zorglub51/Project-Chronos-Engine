{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCE Mini Recovery",
  "version": "0.1.1",
  "identifier": "com.zorglub51.pce-recovery",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "PCE Mini Recovery",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "appimage"
    ],
    "resources": {
      "../../../payloads/": "payloads/",
      "../../../target/release/pce-recovery-network": "pce-recovery-network",
      "../../../packaging/70-pce-recovery.rules": "70-pce-recovery.rules",
      "../../../README.md": "README.md",
      "../../../../LICENSE": "LICENSE"
    }
  }
}
